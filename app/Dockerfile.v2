FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    APP_VERSION=v2.0 \
    APP_TITLE="Cloud Counter - AWS EC2 Cloud Release (v2.0)" \
    REDIS_HOST=redis \
    REDIS_PORT=6379

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py .

EXPOSE 5000

CMD ["python", "app.py"]

